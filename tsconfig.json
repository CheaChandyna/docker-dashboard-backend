{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "target": "es2023",
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
  },
  "include": ["src/**/*"]
}